---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SkeletonCollage from "@/components/SkeletonCollage.astro";
---
<BaseLayout title="Bodas y eventos — Freddy Fotografías" description="Coberturas fotográficas cercanas para bodas, celebraciones y eventos.">
  <main id="main-content">
    <section class="mx-auto max-w-screen-xl px-6 pb-20 pt-24 md:pb-28 md:pt-32"><p class="eyebrow">Freddy Fotografías</p><h1 class="max-w-[13ch] font-serif text-6xl leading-[0.88] md:text-8xl">Celebraciones <span class="italic text-accent">desde dentro.</span></h1><p class="mt-8 max-w-[55ch] text-lg leading-relaxed text-faded">Acompaño el ritmo de cada celebración sin interrumpirlo. Una cobertura cercana para conservar la emoción, las personas y lo que sucede entre un momento y otro.</p><button type="button" class="mt-9 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] hover:bg-accent" data-contact-open>Consultar mi fecha →</button></section>
    <section class="mx-auto max-w-screen-xl px-6 pb-32" aria-labelledby="coberturas-title"><div class="mb-10 border-t border-line pt-10"><p class="eyebrow">Coberturas</p><h2 id="coberturas-title" class="max-w-[18ch] font-serif text-4xl leading-none md:text-6xl">Cada historia tiene <span class="italic text-accent">su propio pulso.</span></h2></div><div class="grid gap-5 md:grid-cols-2">{["Bodas","Bodas civiles","Eventos sociales","Eventos corporativos"].map((name, index) => <article class="skeleton-card min-h-64 relative"><span class="image-skeleton" aria-hidden="true"></span><span class="skeleton-index">0{index + 1}</span><h3 class="font-serif text-4xl">{name}</h3><p>{["Preparativos, ceremonia y celebración con una narrativa completa.","La intimidad de una ceremonia pequeña, cuidando cada encuentro.","Cumpleaños, aniversarios y reuniones contadas con naturalidad.","Lanzamientos y encuentros de marca con imágenes humanas y útiles."][index]}</p><button type="button" class="skeleton-link text-left" data-contact-open>Hablar de esta cobertura →</button></article>)}</div></section>
    <section class="mx-auto mb-32 max-w-screen-xl px-6"><div class="border-y border-line py-14 md:flex md:items-end md:justify-between md:gap-8"><h2 class="max-w-[17ch] font-serif text-4xl leading-none md:text-6xl">¿Listo para contar lo que estás preparando?</h2><button type="button" class="mt-8 rounded-full bg-ink px-7 py-4 text-[11px] uppercase tracking-[0.2em] text-[var(--color-base)] hover:bg-accent md:mt-0" data-contact-open>Hablemos →</button></div></section>
    <section class="mx-auto max-w-screen-xl px-6 pb-24" aria-label="Galería skeleton"><SkeletonCollage label="Collage de cinco imágenes en preparación" /></section>
  </main>
</BaseLayout>
