---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/utils/paths.js";
---

<BaseLayout title="Página no encontrada — Freddy Fotografías" description="La página que buscas no existe o ha cambiado de dirección." noindex={true} includeHeader={false} includeFooter={false}>
  <main id="main-content" class="flex min-h-screen items-center justify-center bg-base px-4">
    <div class="max-w-md text-center">
      <h1 class="font-serif text-7xl">404</h1>
      <h2 class="mt-4 font-serif text-2xl">Página no encontrada</h2>
      <p class="mt-2 text-sm text-faded">La página que buscas no existe o ha cambiado de dirección.</p>
      <div class="mt-6">
        <a
          href={sitePath("/estudio")}
          class="inline-flex items-center justify-center rounded-full bg-ink px-5 py-3 text-xs uppercase tracking-widest text-[var(--color-base)] transition-colors hover:bg-accent"
        >
          Volver al Estudio Creativo
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
