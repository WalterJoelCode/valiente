---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SkeletonCollage from "@/components/SkeletonCollage.astro";
---
<BaseLayout title="Estudio Creativo — Freddy Valiente" description="Retratos y sesiones creativas diseñadas alrededor de cada persona y proyecto.">
  <main id="main-content">
    <section class="mx-auto max-w-screen-xl px-6 pb-20 pt-24 md:pb-28 md:pt-32"><p class="eyebrow">Estudio Creativo</p><h1 class="max-w-[13ch] font-serif text-6xl leading-[0.88] md:text-8xl">Una sesión <span class="italic text-accent">hecha para ti.</span></h1><p class="mt-8 max-w-[55ch] text-lg leading-relaxed text-faded">Retratos personales, de pareja, familia o marca. Empezamos con una conversación y dejamos que la imagen encuentre su forma.</p><button type="button" class="mt-9 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] hover:bg-accent" data-contact-open>Diseñar mi sesión →</button></section>
    <section class="mx-auto max-w-screen-xl px-6 pb-32" aria-labelledby="sesiones-title"><div class="mb-10 border-t border-line pt-10"><p class="eyebrow">Posibilidades</p><h2 id="sesiones-title" class="max-w-[18ch] font-serif text-4xl leading-none md:text-6xl">Un espacio para <span class="italic text-accent">explorarte.</span></h2></div><div class="grid gap-5 md:grid-cols-3">{["Retrato personal","Parejas y familias","Marca personal"].map((name, index) => <article class="skeleton-card min-h-72 relative"><span class="image-skeleton" aria-hidden="true"></span><span class="skeleton-index">0{index + 1}</span><h3 class="font-serif text-4xl">{name}</h3><p>{["Una imagen que se parezca a ti, sin necesidad de impostar.","Una experiencia compartida para guardar cómo se sienten juntos.","Retratos con dirección y claridad para comunicar quién eres."][index]}</p><button type="button" class="skeleton-link text-left" data-contact-open>Consultar esta opción →</button></article>)}</div></section>
    <section class="mx-auto mb-32 max-w-screen-xl px-6"><div class="grid gap-10 border-t border-line pt-12 md:grid-cols-12"><h2 class="font-serif text-4xl leading-none md:col-span-6 md:text-6xl">La mejor dirección es la que te permite <span class="italic text-accent">ser tú.</span></h2><p class="leading-relaxed text-faded md:col-span-5 md:col-start-8">No necesitas saber posar. Te acompaño con indicaciones sencillas, pausas y una atención cuidadosa a lo que quieres expresar.</p></div></section>
    <section class="mx-auto max-w-screen-xl px-6 pb-24" aria-label="Galería skeleton"><SkeletonCollage label="Collage de cinco imágenes en preparación" /></section>
  </main>
</BaseLayout>
