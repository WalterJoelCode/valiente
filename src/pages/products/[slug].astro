---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProducts, getRelated } from "@/data/products.js";
import { sitePath } from "@/utils/paths.js";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, related: getRelated(products, product.slug) },
  }));
}

const { product, related } = Astro.props;
const productUrl = new URL(sitePath(`/products/${product.slug}`), Astro.site ?? Astro.url.origin).href;
---

<BaseLayout
  title={`${product.name} — Freddy Fotografías`}
  description={product.description.slice(0, 155)}
  image={product.images[0]}
>
  <main id="main-content">
  <div class="mx-auto max-w-screen-xl px-6 pt-8">
    <nav class="flex gap-2 text-xs uppercase tracking-widest text-faded" aria-label="Migas de pan">
      <a href={sitePath("/estudio")} class="hover:text-ink">Estudio Creativo</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink" aria-current="page">{product.name}</span>
    </nav>
  </div>

  <div class="mx-auto max-w-screen-xl px-6 py-12">
    <section class="grid grid-cols-1 items-start gap-16 lg:grid-cols-12">
      <div class="space-y-6 lg:col-span-7" data-product-gallery>
        <div class="relative aspect-[4/5] overflow-hidden rounded-[min(1vw,12px)] bg-paper">
          {
            product.images.map((image, index) => (
              <div class:list={["absolute inset-0", index !== 0 && "hidden"]} data-gallery-panel={index}>
                <Image
                  src={image}
                  alt={`${product.name} — vista ${index + 1}`}
                  width={1440}
                  height={1800}
                  format="webp"
                  loading={index === 0 ? "eager" : "lazy"}
                  class="atelier-fade-in h-full w-full object-cover"
                />
              </div>
            ))
          }
        </div>
        <div class="grid grid-cols-3 gap-4">
          {
            product.images.map((image, index) => (
              <button
                type="button"
                class:list={[
                  "aspect-square overflow-hidden rounded-[min(1vw,12px)] bg-paper ring-1 transition-all",
                  index === 0 ? "ring-ink" : "ring-line hover:ring-ink/40",
                ]}
                data-gallery-thumb={index}
                aria-label={`Mostrar vista ${index + 1}`}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <Image src={image} alt="" width={360} height={360} format="webp" loading="lazy" class="h-full w-full object-cover" />
              </button>
            ))
          }
        </div>
      </div>

      <div class="space-y-12 lg:sticky lg:top-24 lg:col-span-5">
        <div class="space-y-4">
          <div class="text-xs uppercase tracking-widest text-faded">{product.collection}</div>
          <h1 class="text-balance font-serif text-4xl leading-tight md:text-5xl">{product.name}</h1>
        </div>

        <div class="space-y-6">
          <p class="max-w-[44ch] text-pretty leading-relaxed text-faded">{product.description}</p>
          <dl class="space-y-3">
            <div class="flex justify-between border-b border-line py-2 text-sm">
              <dt class="text-faded">Estilo</dt>
              <dd>{product.material}</dd>
            </div>
            <div class="flex justify-between border-b border-line py-2 text-sm">
              <dt class="text-faded">Duración</dt>
              <dd>{product.dimensions}</dd>
            </div>
            <div class="flex justify-between border-b border-line py-2 text-sm">
              <dt class="text-faded">Entrega</dt>
              <dd>{product.finish}</dd>
            </div>
            <div class="flex justify-between border-b border-line py-2 text-sm">
              <dt class="text-faded">Tiempo de entrega</dt>
              <dd>{product.leadTime}</dd>
            </div>
          </dl>
        </div>

        <a href={sitePath("/contacto#contacto")} class="inline-flex w-full items-center justify-center gap-3 rounded-full bg-ink py-4 text-sm font-medium text-[var(--color-base)] ring-1 ring-ink transition-all hover:bg-accent hover:ring-accent">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2"></rect><path d="m4 7 8 6 8-6"></path></svg>
          Consultar esta sesión
        </a>

        <p class="text-[11px] uppercase tracking-widest text-faded">
          Atención personalizada · Disponibilidad según solicitud
        </p>
      </div>
    </section>

    <section class="mt-40 space-y-12 border-t border-line pt-16">
      <div class="flex items-end justify-between gap-6">
        <h2 class="font-serif text-3xl md:text-4xl">Sesiones que podrían interesarte</h2>
        <a href={sitePath("/estudio")} class="text-xs uppercase tracking-widest underline underline-offset-4 hover:text-accent">
          Ver todas
        </a>
      </div>
      <div class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-3">
        {related.map((item) => <ProductCard product={item} />)}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    name: product.name,
    description: product.description,
    image: product.images.map((image) => new URL(image.src, Astro.url.origin).href),
    brand: {
      "@type": "Brand",
      name: "Freddy Fotografías",
    },
    material: product.material,
    url: productUrl,
  })}></script>

  <script is:inline>
    const gallery = document.querySelector("[data-product-gallery]");
    if (gallery) {
      const panels = Array.from(gallery.querySelectorAll("[data-gallery-panel]"));
      const thumbs = Array.from(gallery.querySelectorAll("[data-gallery-thumb]"));

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const active = thumb.dataset.galleryThumb;
          panels.forEach((panel) => panel.classList.toggle("hidden", panel.dataset.galleryPanel !== active));
          thumbs.forEach((button) => {
            const selected = button.dataset.galleryThumb === active;
            button.classList.toggle("ring-ink", selected);
            button.classList.toggle("ring-line", !selected);
            button.setAttribute("aria-pressed", selected ? "true" : "false");
          });
        });
      });
    }

  </script>
  </main>
</BaseLayout>
