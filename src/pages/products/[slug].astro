---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProducts } from "@/data/products.js";
import { sitePath } from "@/utils/paths.js";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
---
<BaseLayout title={`${product.name} — Freddy Valiente`} description={product.description.slice(0, 155)}>
  <main id="main-content">
    <div class="mx-auto max-w-screen-xl px-6 pt-8"><nav class="flex gap-2 text-xs uppercase tracking-widest text-faded" aria-label="Migas de pan"><a href={sitePath("/estudio")} class="hover:text-ink">Estudio Creativo</a><span aria-hidden="true">/</span><span class="text-ink" aria-current="page">{product.name}</span></nav></div>
    <section class="mx-auto max-w-screen-xl px-6 py-16 md:py-28"><div class="grid gap-12 border-t border-line pt-10 lg:grid-cols-12"><div class="lg:col-span-7"><p class="eyebrow">{product.collection}</p><h1 class="max-w-[10ch] font-serif text-6xl leading-[0.86] md:text-8xl">{product.name}</h1><p class="mt-8 max-w-[48ch] text-lg leading-relaxed text-faded">{product.description}</p></div><div class="lg:col-span-4 lg:col-start-9"><div class="skeleton-card min-h-0 items-start"><span class="skeleton-index">Sesión personalizada</span><p>Esta propuesta se ajusta a tu historia, contexto y propósito. Hablemos para definirla contigo.</p><button type="button" class="mt-3 rounded-full bg-ink px-6 py-3 text-[11px] uppercase tracking-[0.2em] text-[var(--color-base)] hover:bg-accent" data-contact-open>Consultar esta sesión →</button></div></div></div></section>
    <section class="mx-auto mb-32 max-w-screen-xl px-6"><div class="grid gap-5 md:grid-cols-3"><div class="skeleton-card min-h-0 items-start"><span class="skeleton-index">01</span><h2 class="font-serif text-3xl">Escuchamos</h2><p>Conversamos sobre lo que quieres contar y cómo quieres sentirte frente a la cámara.</p></div><div class="skeleton-card min-h-0 items-start"><span class="skeleton-index">02</span><h2 class="font-serif text-3xl">Diseñamos</h2><p>Definimos juntos el enfoque, el espacio y los detalles que harán tuya la experiencia.</p></div><div class="skeleton-card min-h-0 items-start"><span class="skeleton-index">03</span><h2 class="font-serif text-3xl">Creamos</h2><p>Dejamos que la sesión suceda con dirección cercana y atención a lo que importa.</p></div></div></section>
  </main>
</BaseLayout>
