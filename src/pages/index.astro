---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import heroImg from "@/assets/atelier-hero.jpg";
import { getProducts } from "@/data/products.js";
import { sitePath } from "@/utils/paths.js";

const products = await getProducts();
const featured = ["arvid-chair", "low-plinth-table", "tora-desk"]
  .map((slug) => products.find((product) => product.slug === slug))
  .filter((product) => product !== undefined);
const [photoService, studioService] = featured;
const solo = products.find((product) => product.slug === "monolith-bench");

if (!photoService || !studioService || !solo) {
  throw new Error("Missing one or more required featured products");
}
---

<BaseLayout
  title="Freddy Fotografías — Bodas, eventos y Estudio Creativo"
  description="Fotografía de bodas y eventos, junto a sesiones de estudio y exterior creadas con sensibilidad, cercanía e intención."
  image={heroImg}
>
  <main id="main-content">
  <h1 class="sr-only">Freddy Fotografías — bodas, eventos y sesiones creativas</h1>
  <section class="relative overflow-hidden bg-base">
    <div class="md:hidden">
      <div class="aspect-[4/3] w-full">
        <Image
          src={heroImg}
          alt="Escena artística iluminada por la luz natural del estudio"
          width={1600}
          height={1280}
          format="webp"
          loading="eager"
          decoding="sync"
          class="h-full w-full object-cover object-right"
        />
      </div>
      <div class="space-y-6 px-6 py-12">
        <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
          <span class="inline-block h-px w-8 bg-ink/40"></span>
          Nicaragua · Fotografía de autor
        </p>
        <p class="text-balance font-serif text-4xl leading-[0.95]">
          Dos formas de contar
          <br />
          <span class="italic text-accent">historias que permanecen.</span>
        </p>
        <p class="max-w-[48ch] text-pretty leading-relaxed text-faded">
          Bodas y eventos narrados desde dentro, junto a sesiones de estudio y exterior creadas alrededor de cada persona.
        </p>
        <div class="flex flex-col items-start gap-4 pt-2 sm:flex-row sm:items-center">
          <a
            href={sitePath("/fotografias")}
            class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
          >
            Freddy Fotografías
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a href={sitePath("/estudio")} class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink">
            Estudio Creativo →
          </a>
        </div>
      </div>
    </div>

    <div class="relative hidden h-[88vh] max-h-[920px] min-h-[640px] w-full md:block">
      <Image
        src={heroImg}
        alt="Escena artística iluminada por la luz natural del estudio"
        width={1600}
        height={1280}
        format="webp"
        loading="eager"
        decoding="sync"
        class="absolute inset-0 h-full w-full object-cover object-right"
      />
      <div
        aria-hidden="true"
        class="absolute inset-0"
        style="background: linear-gradient(90deg, var(--color-base) 0%, var(--color-base) 30%, color-mix(in oklab, var(--color-base) 55%, transparent) 45%, color-mix(in oklab, var(--color-base) 5%, transparent) 65%, transparent 80%)"
      >
      </div>
      <div
        aria-hidden="true"
        class="absolute inset-x-0 bottom-0 h-40"
        style="background: linear-gradient(180deg, transparent, var(--color-base))"
      >
      </div>
      <div class="relative mx-auto flex h-full max-w-screen-xl items-center px-6">
        <div class="max-w-[480px] space-y-8">
          <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
            <span class="inline-block h-px w-8 bg-ink/40"></span>
            Nicaragua · Fotografía de autor
          </p>
          <p class="text-balance font-serif text-5xl leading-[0.95] lg:text-6xl">
            Dos formas de contar
            <br />
            <span class="italic text-accent">historias que permanecen.</span>
          </p>
          <p class="max-w-[48ch] text-pretty leading-relaxed text-faded md:text-lg">
            Bodas y eventos narrados desde dentro, junto a sesiones de estudio y exterior creadas alrededor de cada persona.
          </p>
          <div class="flex items-center gap-6 pt-2">
            <a
              href={sitePath("/fotografias")}
              class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
            >
              Freddy Fotografías
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a href={sitePath("/estudio")} class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink">
              Estudio Creativo →
            </a>
          </div>
        </div>
      </div>
      <div class="absolute bottom-10 right-10 hidden flex-col items-end gap-1 text-[10px] uppercase tracking-[0.3em] text-ink/70 md:flex">
        <span>No. 04 — Retrato editorial</span>
        <span class="text-faded">Luz natural · 2025</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-screen-xl px-6 pt-24 md:pt-32" aria-labelledby="servicios-principales">
    <div class="mb-12 border-t border-line pt-10">
      <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded">Nuestros servicios</p>
      <h2 id="servicios-principales" class="max-w-[22ch] text-balance font-serif text-3xl leading-[1.02] md:text-5xl">
        Una misma mirada, <span class="italic text-accent">dos experiencias.</span>
      </h2>
      <p class="mt-5 max-w-[58ch] leading-relaxed text-faded">
        Elige la experiencia que mejor corresponde a tu historia. En ambas encontrarás dirección cercana, atención a la luz y fotografías pensadas para conservarse.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      <article class="group relative min-h-[520px] overflow-hidden rounded-[min(1vw,16px)] bg-paper">
        <Image src={photoService.images[0]} alt="Cobertura fotográfica de bodas y eventos" width={1200} height={1400} format="webp" loading="eager" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.03]" />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 space-y-4 p-7 text-white md:p-10">
          <p class="text-[10px] uppercase tracking-[0.3em] text-white/70">Bodas · Eventos</p>
          <h3 class="font-serif text-4xl leading-none md:text-5xl">Freddy Fotografías</h3>
          <p class="max-w-[44ch] text-sm leading-relaxed text-white/80">Coberturas documentales y cercanas para conservar la emoción, las personas y el pulso de cada celebración.</p>
          <a href={sitePath("/fotografias")} class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.2em] text-white underline decoration-white/40 underline-offset-4 transition-colors hover:decoration-white">Conocer el servicio <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="group relative min-h-[520px] overflow-hidden rounded-[min(1vw,16px)] bg-paper">
        <Image src={studioService.images[0]} alt="Sesión fotográfica de estudio y exterior" width={1200} height={1400} format="webp" loading="eager" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.03]" />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 space-y-4 p-7 text-white md:p-10">
          <p class="text-[10px] uppercase tracking-[0.3em] text-white/70">Estudio · Exteriores</p>
          <h3 class="font-serif text-4xl leading-none md:text-5xl">Estudio Creativo</h3>
          <p class="max-w-[44ch] text-sm leading-relaxed text-white/80">Retratos personales, de pareja, familia o marca diseñados alrededor de tu identidad y propósito.</p>
          <a href={sitePath("/estudio")} class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.2em] text-white underline decoration-white/40 underline-offset-4 transition-colors hover:decoration-white">Explorar las sesiones <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-screen-xl px-6 pt-24 md:pt-32">
    <div class="mb-12 flex items-end justify-between gap-6 border-t border-line pt-10">
      <div>
        <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded">Actualmente en el estudio</p>
        <h2 class="max-w-[20ch] text-balance font-serif text-3xl md:text-5xl">
          Algunas sesiones, <span class="italic text-accent">listas para inspirarte.</span>
        </h2>
      </div>
      <a
        href={sitePath("/estudio")}
        class="hidden items-center gap-2 whitespace-nowrap text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink md:inline-flex"
      >
        Ver todas
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-3">
      {featured.map((product) => <ProductCard product={product} />)}
    </div>

    <div class="mt-10 flex justify-center md:hidden">
      <a href={sitePath("/estudio")} class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink">
        Ver todas las sesiones →
      </a>
    </div>
  </section>

  <section class="mt-32 md:mt-48">
    <div class="mx-auto max-w-screen-2xl px-6">
      <div class="grid items-center gap-10 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-7 lg:col-span-8">
          <a
            href={sitePath(`/products/${solo.slug}`)}
            class="group block aspect-[5/4] overflow-hidden rounded-[min(1vw,16px)] bg-paper md:aspect-[16/11]"
          >
            <Image
              src={solo.images[0]}
              alt={`${solo.name} — ${solo.shortDescription}`}
              width={1600}
              height={1100}
              loading="lazy"
              format="webp"
              class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.02]"
            />
          </a>
        </div>
        <div class="space-y-6 md:col-span-5 lg:col-span-4">
          <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
            <span class="inline-block h-px w-8 bg-ink/40"></span>
            Retrato de marca
          </p>
          <h2 class="text-balance font-serif text-4xl leading-[1.02] md:text-5xl">
            Tu identidad, <span class="italic text-accent">en imágenes.</span>
          </h2>
          <p class="text-pretty leading-relaxed text-faded">{solo.description}</p>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-3 border-t border-line pt-2 text-xs">
            <dt class="pt-3 uppercase tracking-[0.2em] text-faded">Duración</dt>
            <dd class="pt-3">{solo.dimensions}</dd>
            <dt class="uppercase tracking-[0.2em] text-faded">Entrega</dt>
            <dd>{solo.finish}</dd>
            <dt class="uppercase tracking-[0.2em] text-faded">Plazo</dt>
            <dd>{solo.leadTime}</dd>
            <dt class="uppercase tracking-[0.2em] text-faded">Sesión</dt>
            <dd>Personalizada</dd>
          </dl>
          <a
            href={sitePath(`/products/${solo.slug}`)}
            class="inline-flex items-center gap-3 rounded-full bg-ink px-6 py-3.5 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
          >
            Ver la sesión →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-32 max-w-screen-xl px-6 md:mt-48">
    <div class="border-t border-line pt-12">
      <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded">Dos formas de contar historias</p>
      <h2 class="mb-12 max-w-[22ch] text-balance font-serif text-3xl md:text-5xl">
        Una mirada consistente, <span class="italic text-accent">en cada contexto</span>.
      </h2>
      <div class="grid gap-x-8 gap-y-10 md:grid-cols-3">
        {
          [
            {
              name: "Bodas",
              tag: "Emoción · memoria",
              copy: "Una narración documental del día, desde los preparativos hasta la celebración, atenta a todo lo que ocurre entre ambos momentos.",
            },
            {
              name: "Eventos",
              tag: "Ambiente · personas",
              copy: "Coberturas sociales y corporativas que conservan la energía del encuentro y producen imágenes útiles para volver a comunicarlo.",
            },
            {
              name: "Estudio Creativo",
              tag: "Dirección · identidad",
              copy: "Sesiones en estudio o exteriores, pensadas alrededor de la persona, la luz y el propósito que tendrán las fotografías.",
            },
          ].map((material) => (
            <div class="space-y-3 pt-2">
              <p class="text-[10px] uppercase tracking-[0.3em] text-faded">{material.tag}</p>
              <h3 class="font-serif text-2xl">{material.name}</h3>
              <p class="text-sm leading-relaxed text-faded">{material.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto mt-32 max-w-screen-xl px-6 md:mt-48" aria-labelledby="opiniones-title">
    <div class="border-t border-line pt-12">
      <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded">Opiniones</p>
      <h2 id="opiniones-title" class="max-w-[22ch] text-balance font-serif text-3xl leading-[1.02] md:text-5xl">
        Historias vistas desde <span class="italic text-accent">el otro lado de la cámara.</span>
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {[
          {
            quote: "Freddy logró que olvidáramos la cámara. Las fotografías se sienten como nuestro día: cercanas, alegres y completamente nuestras.",
            name: "María y Carlos",
            service: "Boda",
          },
          {
            quote: "La dirección fue clara y tranquila desde el primer momento. Recibí retratos naturales que realmente representan mi trabajo y personalidad.",
            name: "Ana Lucía Ruiz",
            service: "Retrato de marca",
          },
          {
            quote: "Capturó el ambiente del evento sin interrumpirlo. Cada imagen cuenta algo y nos permitió revivir detalles que no habíamos visto ese día.",
            name: "Sofía Mendoza",
            service: "Evento social",
          },
        ].map((review) => (
          <figure class="flex h-full flex-col rounded-[min(1vw,12px)] bg-paper p-7 md:p-8">
            <div class="mb-6 flex gap-1 text-accent" aria-label="5 de 5 estrellas">
              {Array.from({ length: 5 }).map(() => (
                <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="m12 2.8 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 2.8Z"></path></svg>
              ))}
            </div>
            <blockquote class="flex-1 text-pretty font-serif text-2xl leading-[1.2]">“{review.quote}”</blockquote>
            <figcaption class="mt-8 border-t border-line pt-5">
              <p class="text-sm font-medium">{review.name}</p>
              <p class="mt-1 text-[10px] uppercase tracking-[0.25em] text-faded">{review.service}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Freddy Fotografías",
    url: new URL(import.meta.env.BASE_URL, Astro.site).href,
    slogan: "Historias a través de la luz",
    address: {
      "@type": "PostalAddress",
      addressCountry: "NI",
    },
  })}></script>

  </main>
</BaseLayout>
