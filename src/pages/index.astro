---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SkeletonCollage from "@/components/SkeletonCollage.astro";
import { sitePath } from "@/utils/paths.js";
---
<BaseLayout title="Freddy Valiente — Fotografía con intención" description="Fotografía de bodas, eventos y retratos con una mirada cercana, honesta y personal.">
  <main id="main-content">
    <section class="mx-auto max-w-screen-xl px-6 pb-24 pt-24 md:pb-36 md:pt-36">
      <p class="eyebrow">Nicaragua · Fotografía de autor</p>
      <h1 class="max-w-[12ch] text-balance font-serif text-6xl leading-[0.86] md:text-8xl">Historias que <span class="italic text-accent">se sienten.</span></h1>
      <p class="mt-8 max-w-[48ch] text-lg leading-relaxed text-faded">Una mirada sensible para bodas, eventos, retratos y proyectos que merecen ser recordados con honestidad.</p>
      <div class="mt-10 flex flex-wrap items-center gap-4"><a href={sitePath("/fotografias")} class="rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] hover:bg-accent">Ver servicios →</a><a href={sitePath("/estudio")} class="rounded-full border border-line px-7 py-4 text-[11px] uppercase tracking-[0.2em] hover:border-ink">Conocer el estudio</a></div>
    </section>
    <section class="mx-auto max-w-screen-xl px-6 pb-32" aria-labelledby="servicios-title">
      <div class="mb-10 border-t border-line pt-10"><p class="eyebrow">Dos caminos</p><h2 id="servicios-title" class="max-w-[19ch] font-serif text-4xl leading-none md:text-6xl">Una misma mirada, <span class="italic text-accent">dos experiencias.</span></h2></div>
      <div class="grid gap-5 md:grid-cols-2"><a href={sitePath("/fotografias")} class="skeleton-card group relative"><span class="image-skeleton" aria-hidden="true"></span><span class="skeleton-index">01</span><h3 class="font-serif text-4xl">Freddy Fotografías</h3><p>Historias documentales para bodas y eventos, narradas desde dentro.</p><span class="skeleton-link">Explorar coberturas →</span></a><a href={sitePath("/estudio")} class="skeleton-card group relative"><span class="image-skeleton" aria-hidden="true"></span><span class="skeleton-index">02</span><h3 class="font-serif text-4xl">Estudio Creativo</h3><p>Retratos y sesiones pensados alrededor de tu identidad, tu ritmo y tu propósito.</p><span class="skeleton-link">Explorar sesiones →</span></a></div>
    </section>
    <section class="mx-auto max-w-screen-xl px-6 pb-32" aria-labelledby="inicio-manifiesto"><div class="grid gap-10 border-t border-line pt-12 md:grid-cols-12 md:gap-16"><h2 id="inicio-manifiesto" class="font-serif text-4xl leading-none md:col-span-6 md:text-6xl">Menos pose. <span class="italic text-accent">Más presencia.</span></h2><div class="space-y-5 leading-relaxed text-faded md:col-span-5 md:col-start-8"><p>Antes de hacer una fotografía, escuchamos. Así cada sesión encuentra su propia forma sin forzar momentos ni gestos.</p><p>La estructura queda abierta para que la historia se construya contigo.</p></div></div></section>
    <section class="mx-auto max-w-screen-xl px-6 pb-24" aria-label="Galería skeleton"><SkeletonCollage label="Collage de cinco imágenes en preparación" /></section>
  </main>
</BaseLayout>
