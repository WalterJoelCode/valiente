---
import "../styles.css";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import ContactModal from "@/components/ContactModal.astro";
import SocialRail from "@/components/SocialRail.astro";
import { sitePath } from "@/utils/paths.js";
import interRegular from "@/assets/fonts/inter-latin-400-normal.woff2";
import instrumentRegular from "@/assets/fonts/instrument-serif-latin-400-normal.woff2";

const {
  title = "Freddy Fotografías — Fotografía con intención",
  description = "Fotografía de autor, sesiones de estudio y una mirada honesta a cada historia.",
  noindex = false,
  includeHeader = true,
  includeFooter = true,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Freddy Valiente" />
    <meta name="theme-color" content="#f8f7f4" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrumentRegular} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Freddy Fotografías" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

  </head>
  <body class="bg-base text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-[var(--color-base)]"
    >
      Saltar al contenido
    </a>
    {includeHeader && <SiteHeader currentPath={Astro.url.pathname} />}
    <div>
      <slot />
    </div>
    <ContactModal />
    <SocialRail />
    {includeFooter && <SiteFooter />}
  </body>
</html>
